{
  "name": "skillpath-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 5173",
    "dev:api": "node server/index.ts",
    "test:db": "node tests/db-pg.mjs",
    "test:api": "node tests/api-pg.mjs",
    "test:eval": "node tests/practice-v2.mjs",
    "test:mastery": "node tests/mastery.mjs",
    "test:capability": "node tests/capability-v2.mjs",
    "test": "npm run test:eval && npm run test:mastery && npm run test:capability && npm run test:db && npm run test:api",
    "build": "tsc && vite build",
    "build:function": "node netlify/build-function.mjs",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.28.2",
    "pg-mem": "^3.0.14",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
